{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pronto",
  "version": "0.8.2",
  "identifier": "app.pronto.dictation",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pronto",
        "width": 1060,
        "height": 720,
        "minWidth": 780,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Pronto is listening",
        "url": "overlay.html",
        "width": 170,
        "height": 32,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "search",
        "title": "Pronto Search",
        "url": "search.html",
        "width": 120,
        "height": 32,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../runtime/nemo-speech/bin/": "runtime/nemo-speech/bin/",
      "../runtime/nemo-speech/share/licenses/": "runtime/nemo-speech/share/licenses/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/design-system.json": "resources/design-system.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
